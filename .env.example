# Browser Agents Configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# =============================================================================
# LLM Configuration (Ollama)
# =============================================================================

# Ollama model for recording conversion (must be pulled first)
LOCAL_MODEL=gpt-oss:120b

# Ollama API URL (default works for local Ollama installation)
OLLAMA_URL=http://localhost:11434
